{
  "expo": {
    "name": "OP Boosters",
    "slug": "OP-TCG-BOOSTER",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/xxb-open"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pour photographier tes cartes One Piece et les reconnaître."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour importer une photo de carte à identifier.",
          "cameraPermission": "Pour photographier tes cartes One Piece et les reconnaître.",
          "microphonePermission": false
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/BoosterOP.glb",
            "./assets/OP_CARD.glb",
            "./assets/OP_CARD_BACK.webp",
            "./assets/packs/op01.jpg",
            "./assets/packs/op02.jpg",
            "./assets/packs/op03.jpg",
            "./assets/packs/op05.jpg",
            "./assets/packs/op06.jpg",
            "./assets/packs/op09.jpg",
            "./assets/packs/eb01.jpg",
            "./assets/packs/op13.jpg",
            "./assets/packs/op14.jpg",
            "./assets/packs/op15.jpg",
            "./assets/packs/op16.jpg",
            "./assets/packs/op17.jpg"
          ]
        }
      ]
    ]
  }
}
